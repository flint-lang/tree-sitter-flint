"string";
// <- string

$"interpolated {x}"
// <- string

42;
// <- number

.3f;
// <- number

true;
// <- boolean

false;
// <- boolean

none;
// <- constant.builtin

_;
// <- constant.builtin

if expr:
// <- keyword
    x;
else:
// <- keyword
    y;

switch expr:
// <- keyword
    RED -> x;

for i32 i in x:
// <- keyword
    y;

do:
// <- keyword
    x;
while expr;
